# Copy to .env.local and fill in your Supabase project values.
# Found in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The Finnhub key is NOT used here — it lives server-side as a Supabase
# Edge Function secret (see supabase/functions/market-data). Set it with:
#   supabase secrets set FINNHUB_API_KEY=your-key

# Only needed to run the scheduled snapshot job locally:
#   npm run snapshot:local
# In CI these are GitHub Actions secrets (see .github/workflows/snapshot.yml),
# where SUPABASE_URL / SUPABASE_ANON_KEY are supplied without the VITE_ prefix.
# The job signs in as this user, so it writes under that account's RLS.
SUPABASE_EMAIL=you@example.com
SUPABASE_PASSWORD=your-supabase-account-password
