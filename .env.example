# Copy to .env.local and fill in your own Supabase project values.
# Found in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Server-side only — set as Supabase Edge Function secrets, never in the client
# bundle. The anon key above is safe to ship; these are not.
#
#   supabase secrets set FINNHUB_API_KEY=your-key
#   supabase secrets set PUBLI_API_KEY=your-key
#   supabase secrets set PUBLIC_ACCOUNT_ID=your-public-com-account-id
#
# PUBLIC_ACCOUNT_ID is the account the Public.com market-data endpoints are
# addressed through. It identifies a real brokerage account, so it is
# configuration, not a constant — do not hardcode it.
# ---------------------------------------------------------------------------

# Only needed to run the snapshot job locally:
#   npm run snapshot:local
# The scheduled version of this job lives in a separate private repo, because it
# signs in as a real account.
SUPABASE_EMAIL=you@example.com
SUPABASE_PASSWORD=your-supabase-account-password
