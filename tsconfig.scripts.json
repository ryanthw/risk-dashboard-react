{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Not composite: this project only typechecks, and a composite project
    // would have to enumerate every src file the script transitively imports.
    "composite": false,
    "tsBuildInfoFile": null,
    // Node, not the browser: no DOM lib, and @types/node for process/env.
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts"]
}
