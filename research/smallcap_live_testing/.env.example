# Copy to `.env` (gitignored) and fill in. Sourced by run.sh.
# PUBLI_API_KEY: leave blank to auto-read from ~/.zshrc, or set explicitly.
PUBLI_API_KEY=
# Gmail SMTP (create an App Password: Google Account > Security > 2-Step
# Verification > App passwords). NOT your normal password.
WHEEL_SMTP_USER=ryan1walker5@gmail.com
WHEEL_SMTP_PASS=your_16_char_app_password
WHEEL_EMAIL_TO=ryan1walker5@gmail.com
# Account state (update as the paper account changes)
WHEEL_EQUITY=100000
WHEEL_CASH=100000
WHEEL_POSITIONS=research/smallcap_live_testing/positions.csv
# Exit variant: blank = pure hold-and-CC (default policy); 0.70 = bail30
WHEEL_BAIL=
